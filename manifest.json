{
  "manifest_version": 3,
  "name": "Arnie the Eliminator",
  "version": "1.0.2",
  "description": "Hasta la vista, baby. Eliminates intrusive popups and unlocks page scrolling.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "arnie-the-eliminator@local.extension",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arnie the Eliminator",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
